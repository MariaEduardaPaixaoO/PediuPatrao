# ---------------------------------------------------------------------------
# Copie este arquivo para ".env" (na pasta onde a aplicação é executada) e preencha.
# O arquivo ".env" está no .gitignore: NUNCA o envie para o repositório.
# Todos os valores abaixo são exemplos/fictícios.
# ---------------------------------------------------------------------------

# Conexão com o MongoDB (local ou Atlas)
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=pizzaria

# Use true somente se o MongoDB for um replica set (ex.: Atlas) e você quiser transações reais
# entre a operação de negócio e a auditoria. Em MongoDB local standalone, deixe false.
MONGODB_TRANSACOES=false

# Fuso horário dos horários de entrada/saída/auditoria
PEDIU_TIMEZONE=America/Sao_Paulo

# Administrador inicial (criado apenas se ainda não existir nenhum ADMIN). Mínimo 8 caracteres.
PEDIU_ADMIN_USERNAME=admin
PEDIU_ADMIN_PASSWORD=defina-uma-senha-forte-aqui

# Usuários de demonstração (gerente01 e atendente01) - opcional, para ambiente de teste/vídeo
PEDIU_SEED_ENABLED=false
PEDIU_SEED_GERENTE_PASSWORD=defina-uma-senha-para-gerente01
PEDIU_SEED_ATENDENTE_PASSWORD=defina-uma-senha-para-atendente01
